{
  "manifest_version": 3,
  "name": "LinkCompass Route Reminder",
  "description": "Prompts to remember LinkCompass browser routes after LinkCompass forwards a link.",
  "version": "0.1.0",
  "permissions": [
    "nativeMessaging",
    "notifications",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
